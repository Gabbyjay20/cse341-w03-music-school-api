{
  "openapi": "3.0.0",
  "info": {
    "title": "Music School API",
    "description": "CSE 341 Music School API with CRUD operations, validation, error handling, and GitHub OAuth authentication.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Local development server"
    },
    {
      "url": "https://cse341-w03-music-school-api.onrender.com",
      "description": "Production server on Render"
    }
  ],
  "tags": [
    {
      "name": "Authentication",
      "description": "GitHub OAuth authentication"
    },
    {
      "name": "Students",
      "description": "Manage music school students"
    },
    {
      "name": "Lessons",
      "description": "Manage music lessons"
    },
    {
      "name": "Teachers",
      "description": "Manage music school teachers"
    },
    {
      "name": "Users",
      "description": "Manage application users"
    }
  ],
  "components": {
    "securitySchemes": {
      "sessionAuth": {
        "type": "apiKey",
        "in": "cookie",
        "name": "connect.sid",
        "description": "GitHub OAuth authentication using the Express session cookie."
      }
    },
    "schemas": {
      "Student": {
        "type": "object",
        "required": [
          "firstName",
          "lastName",
          "email",
          "age",
          "instrument",
          "level",
          "parentName",
          "phone"
        ],
        "properties": {
          "firstName": {
            "type": "string",
            "example": "Daniel"
          },
          "lastName": {
            "type": "string",
            "example": "James"
          },
          "email": {
            "type": "string",
            "format": "email",
            "example": "daniel@example.com"
          },
          "age": {
            "type": "integer",
            "minimum": 1,
            "example": 8
          },
          "instrument": {
            "type": "string",
            "example": "Piano"
          },
          "level": {
            "type": "string",
            "example": "Beginner"
          },
          "parentName": {
            "type": "string",
            "example": "Gabriel James"
          },
          "phone": {
            "type": "string",
            "example": "08012345678"
          }
        }
      },
      "Lesson": {
        "type": "object",
        "required": [
          "studentId",
          "instrument",
          "lessonDate",
          "lessonTime",
          "duration",
          "teacher"
        ],
        "properties": {
          "studentId": {
            "type": "string",
            "example": "6ab679c45109847cd089f8ea"
          },
          "instrument": {
            "type": "string",
            "example": "Piano"
          },
          "lessonDate": {
            "type": "string",
            "example": "2026-10-12"
          },
          "lessonTime": {
            "type": "string",
            "example": "15:00"
          },
          "duration": {
            "type": "integer",
            "minimum": 1,
            "example": 30
          },
          "teacher": {
            "type": "string",
            "example": "Gabriel James"
          }
        }
      },
      "Teacher": {
        "type": "object",
        "required": [
          "firstName",
          "lastName",
          "email",
          "instrument",
          "phone"
        ],
        "properties": {
          "firstName": {
            "type": "string",
            "example": "Grace"
          },
          "lastName": {
            "type": "string",
            "example": "Williams"
          },
          "email": {
            "type": "string",
            "format": "email",
            "example": "grace@example.com"
          },
          "instrument": {
            "type": "string",
            "example": "Piano"
          },
          "phone": {
            "type": "string",
            "example": "08012345678"
          }
        }
      },
      "User": {
        "type": "object",
        "required": [
          "name",
          "username",
          "provider"
        ],
        "properties": {
          "name": {
            "type": "string",
            "example": "Gabriel James"
          },
          "username": {
            "type": "string",
            "example": "Gabbyjay20"
          },
          "email": {
            "type": "string",
            "nullable": true,
            "example": null
          },
          "provider": {
            "type": "string",
            "example": "github"
          }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "example": "An error occurred."
          }
        }
      }
    }
  },
  "paths": {
    "/auth/github": {
      "get": {
        "tags": [
          "Authentication"
        ],
        "summary": "Log in using GitHub",
        "responses": {
          "302": {
            "description": "Redirects to GitHub authentication"
          }
        }
      }
    },
    "/auth/github/callback": {
      "get": {
        "tags": [
          "Authentication"
        ],
        "summary": "GitHub OAuth callback",
        "responses": {
          "302": {
            "description": "Authentication successful; redirects to the profile"
          },
          "401": {
            "description": "Authentication failed"
          }
        }
      }
    },
    "/auth/profile": {
      "get": {
        "tags": [
          "Authentication"
        ],
        "summary": "Get the authenticated user's profile",
        "security": [
          {
            "sessionAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Authenticated user profile"
          },
          "401": {
            "description": "Authentication required"
          },
          "500": {
            "description": "Server error"
          }
        }
      }
    },
    "/auth/logout": {
      "get": {
        "tags": [
          "Authentication"
        ],
        "summary": "Log out",
        "responses": {
          "200": {
            "description": "Successfully logged out"
          },
          "500": {
            "description": "Unable to log out"
          }
        }
      }
    },
