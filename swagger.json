          }
        },
        "responses": {
          "204": {
            "description": "Student updated"
          },
          "400": {
            "description": "Invalid student data or ID"
          },
          "401": {
            "description": "Authentication required"
          },
          "404": {
            "description": "Student not found"
          },
          "500": {
            "description": "Server error"
          }
        }
      },
      "delete": {
        "tags": [
          "Students"
        ],
        "summary": "Delete a student",
        "security": [
          {
            "sessionAuth": []
