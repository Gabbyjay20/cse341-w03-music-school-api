{
  "openapi": "3.0.0",
  "info": {
    "title": "Music School API",
    "description": "REST API for managing music school students and lessons with GitHub OAuth authentication.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://cse341-w03-music-school-api.onrender.com"
    }
  ],
  "tags": [
    {
      "name": "Authentication",
      "description": "GitHub OAuth authentication"
    },
    {
      "name": "Students",
      "description": "Student management endpoints"
    },
    {
      "name": "Lessons",
      "description": "Lesson management endpoints"
    }
  ],
  "paths": {
    "/auth/github": {
      "get": {
        "summary": "Login with GitHub",
        "description": "Starts the GitHub OAuth authentication process.",
        "tags": ["Authentication"],
        "responses": {
          "302": {
            "description": "Redirects the user to GitHub for authentication."
          }
        }
      }
    },

    "/auth/github/callback": {
      "get": {
        "summary": "GitHub OAuth callback",
        "description": "GitHub redirects the user to this endpoint after authentication.",
        "tags": ["Authentication"],
        "responses": {
          "302": {
            "description": "Redirects to the authenticated user's profile."
          },
          "401": {
            "description": "GitHub authentication failed."
          }
        }
      }
    },

    "/auth/profile": {
      "get": {
        "summary": "Get authenticated user profile",
        "description": "Returns the profile of the currently authenticated GitHub user.",
        "tags": ["Authentication"],
        "security": [
          {
            "sessionAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Authenticated user profile returned successfully."
          },
          "401": {
            "description": "User is not authenticated."
          },
          "500": {
            "description": "Server error."
          }
        }
      }
    },

    "/auth/logout": {
      "get": {
        "summary": "Log out",
        "description": "Logs out the currently authenticated user and destroys the session.",
        "tags": ["Authentication"],
        "responses": {
          "200": {
            "description": "Successfully logged out."
          },
          "500": {
            "description": "Unable to log out."
          }
        }
      }
    },

    "/students": {
      "get": {
        "summary": "Get all students",
        "description": "Returns all students. Authentication is required.",
        "tags": ["Students"],
        "security": [
          {
            "sessionAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "List of all students."
          },
          "401": {
            "description": "Authentication required."
          },
          "500": {
            "description": "Server error."
          }
        }
      },

      "post": {
        "summary": "Create a student",
        "description": "Creates a new student. Authentication is required.",
        "tags": ["Students"],
        "security": [
          {
            "sessionAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Student"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Student created successfully."
          },
          "400": {
            "description": "Validation error."
          },
          "401": {
            "description": "Authentication required."
          },
          "500": {
            "description": "Server error."
          }
        }
      }
    },

    "/students/{id}": {
      "get": {
        "summary": "Get a student",
        "description": "Returns a single student by MongoDB ObjectId. Authentication is required.",
        "tags": ["Students"],
        "security": [
          {
            "sessionAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/id"
          }
        ],
        "responses": {
          "200": {
            "description": "Student found."
          },
          "400": {
            "description": "Invalid ID."
          },
          "401": {
            "description": "Authentication required."
          },
          "404": {
            "description": "Student not found."
          },
          "500": {
            "description": "Server error."
          }
        }
      },

      "put": {
        "summary": "Update a student",
        "description": "Updates an existing student. Authentication is required.",
        "tags": ["Students"],
        "security": [
          {
            "sessionAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/id"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Student"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Student updated successfully."
          },
          "400": {
            "description": "Validation error or invalid ID."
          },
          "401": {
            "description": "Authentication required."
          },
          "404": {
            "description": "Student not found."
          },
          "500": {
            "description": "Server error."
          }
        }
      },

      "delete": {
        "summary": "Delete a student",
        "description": "Deletes an existing student. Authentication is required.",
        "tags": ["Students"],
        "security": [
          {
            "sessionAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/id"
          }
        ],
        "responses": {
          "204": {
            "description": "Student deleted successfully."
          },
          "400": {
            "description": "Invalid ID."
          },
          "401": {
            "description": "Authentication required."
          },
          "404": {
            "description": "Student not found."
          },
          "500": {
            "description": "Server error."
          }
        }
      }
    },

    "/lessons": {
      "get": {
        "summary": "Get all lessons",
        "description": "Returns all lessons. Authentication is required.",
        "tags": ["Lessons"],
        "security": [
          {
            "sessionAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "List of all lessons."
          },
          "401": {
            "description": "Authentication required."
          },
          "500": {
            "description": "Server error."
          }
        }
      },

      "post": {
        "summary": "Create a lesson",
        "description": "Creates a new lesson. Authentication is required.",
        "tags": ["Lessons"],
        "security": [
          {
            "sessionAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Lesson"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Lesson created successfully."
          },
          "400": {
            "description": "Validation error."
          },
          "401": {
            "description": "Authentication required."
          },
          "500": {
            "description": "Server error."
          }
        }
      }
    },

    "/lessons/{id}": {
      "get": {
        "summary": "Get a lesson",
        "description": "Returns a single lesson by MongoDB ObjectId. Authentication is required.",
        "tags": ["Lessons"],
        "security": [
          {
            "sessionAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/id"
          }
        ],
        "responses": {
          "200": {
            "description": "Lesson found."
          },
          "400": {
            "description": "Invalid ID."
          },
          "401": {
            "description": "Authentication required."
          },
          "404": {
            "description": "Lesson not found."
          },
          "500": {
            "description": "Server error."
          }
        }
      },

      "put": {
        "summary": "Update a lesson",
        "description": "Updates an existing lesson. Authentication is required.",
        "tags": ["Lessons"],
        "security": [
          {
            "sessionAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/id"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Lesson"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Lesson updated successfully."
          },
          "400": {
            "description": "Validation error or invalid ID."
          },
          "401": {
            "description": "Authentication required."
          },
          "404": {
            "description": "Lesson not found."
          },
          "500": {
            "description": "Server error."
          }
        }
      },

      "delete": {
        "summary": "Delete a lesson",
        "description": "Deletes an existing lesson. Authentication is required.",
        "tags": ["Lessons"],
        "security": [
          {
            "sessionAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/id"
          }
        ],
        "responses": {
          "204": {
            "description": "Lesson deleted successfully."
          },
          "400": {
            "description": "Invalid ID."
          },
          "401": {
            "description": "Authentication required."
          },
          "404": {
            "description": "Lesson not found."
          },
          "500": {
            "description": "Server error."
          }
        }
      }
    }
  },

  "components": {
    "securitySchemes": {
      "sessionAuth": {
        "type": "apiKey",
        "in": "cookie",
        "name": "connect.sid",
        "description": "Authentication is handled through the Express session after GitHub OAuth login."
      }
    },

    "parameters": {
      "id": {
        "name": "id",
        "in": "path",
        "required": true,
        "description": "MongoDB ObjectId",
        "schema": {
          "type": "string",
          "example": "6ab4ffed6cf4f34d80f9fefc"
        }
      }
    },

    "schemas": {
      "Student": {
        "type": "object",
        "required": [
          "firstName",
          "lastName",
          "email",
          "age",
          "instrument",
          "level",
          "parentName",
          "phone"
        ],
        "properties": {
          "firstName": {
            "type": "string",
            "example": "Brandon"
          },
          "lastName": {
            "type": "string",
            "example": "James"
          },
          "email": {
            "type": "string",
            "format": "email",
            "example": "brandon@example.com"
          },
          "age": {
            "type": "integer",
            "example": 9
          },
          "instrument": {
            "type": "string",
            "example": "Piano"
          },
          "level": {
            "type": "string",
            "example": "Beginner"
          },
          "parentName": {
            "type": "string",
            "example": "Gabriel James"
          },
          "phone": {
            "type": "string",
            "example": "08012345678"
          }
        }
      },

      "Lesson": {
        "type": "object",
        "required": [
          "studentId",
          "instrument",
          "lessonDate",
          "lessonTime",
          "duration",
          "teacher"
        ],
        "properties": {
          "studentId": {
            "type": "string",
            "example": "6ab4ffed6cf4f34d80f9fefc"
          },
          "instrument": {
            "type": "string",
            "example": "Piano"
          },
          "lessonDate": {
            "type": "string",
            "format": "date",
            "example": "2026-09-25"
          },
          "lessonTime": {
            "type": "string",
            "example": "15:00"
          },
          "duration": {
            "type": "integer",
            "example": 30
          },
          "teacher": {
            "type": "string",
            "example": "Gabriel James"
          }
        }
      }
    }
  }
}




