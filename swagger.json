          "200": {
            "description": "Student found"
          },
          "400": {
            "description": "Invalid student ID"
          },
          "401": {
            "description": "Authentication required"
          },
          "404": {
            "description": "Student not found"
          },
          "500": {
            "description": "Server error"
          }
        }
      },
      "put": {
        "tags": [
          "Students"
        ],
        "summary": "Update a student",
        "security": [
          {
            "sessionAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
